  {"id":"pdf-ingest-heading","type":"comment","z":"pdf-rag-tab","name":"1. INDEX THE PDF — replace only the PDF extraction boundary; keep the RAG pipeline","info":"This horizontal lane creates one message per PDF page so metadata can retain the page number for citations. Built-in memory is for local demos only.","x":610,"y":60,"wires":[]},
  {"id":"pdf-ingest","type":"inject","z":"pdf-rag-tab","name":"Ingest example PDF pages","props":[{"p":"payload"}],"payload":"","payloadType":"date","x":130,"y":150,"wires":[["pdf-extract"]]},
  {"id":"pdf-extract","type":"function","z":"pdf-rag-tab","name":"PDF text extraction boundary (replace)","func":"// Replace this Function with your local PDF parser. Send one message per page.\nconst pages = [\n  'Page 1: Refunds may be requested within thirty calendar days of purchase when an order ID is provided.',\n  'Page 2: Approved refunds are returned to the original payment method within five business days.'\n];\npages.forEach((content, index) => node.send({ rag: { tenantId: 'demo', document: { id: `employee-handbook-2026-p${index + 1}`, content, source: 'employee-handbook-2026.pdf', metadata: { page: index + 1, acl: ['support'], category: 'refund-policy' } } } }));\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":360,"y":150,"wires":[["pdf-metadata"]]},
  {"id":"pdf-metadata","type":"rag-metadata-validator","z":"pdf-rag-tab","name":"Validate page metadata","requiredFields":"[\"id\",\"content\",\"source\"]","x":560,"y":150,"wires":[["pdf-pii"],["pdf-audit"]]},
