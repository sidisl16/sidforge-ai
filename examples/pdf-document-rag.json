  {"id":"pdf-context","type":"function","z":"pdf-rag-tab","name":"Set tenant, role, request ID","func":"msg.rag = Object.assign({}, msg.rag, { tenantId: 'demo', requestId: `pdf-demo-${Date.now()}`, user: { id: 'support-agent', roles: ['support'] } });\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":350,"y":500,"wires":[["pdf-query-normalize"]]},
