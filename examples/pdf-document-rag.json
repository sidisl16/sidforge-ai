[
  {"id":"pdf-rag-tab","type":"tab","label":"PDF — Local Grounded RAG","disabled":false,"info":"A readable, page-aware PDF RAG example. Configure Ollama, deploy, run Ingest example PDF pages, then Ask a grounded PDF question. Replace the clearly marked PDF extraction Function with your local PDF parser or an HTTP extraction service."},
