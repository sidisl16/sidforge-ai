{
  "name": "node-red-contrib-sidforge-ai",
  "version": "0.1.0",
  "description": "Production-minded, provider-neutral RAG building blocks for Node-RED.",
  "keywords": ["node-red", "rag", "ai", "llm", "vector-search", "embeddings", "knowledge-base"],
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "main": "nodes/index.js",
  "repository": { "type": "git", "url": "git+https://github.com/sidisl16/sidforge-ai.git" },
  "bugs": { "url": "https://github.com/sidisl16/sidforge-ai/issues" },
  "homepage": "https://github.com/sidisl16/sidforge-ai#readme",
  "engines": { "node": ">=22" },
  "node-red": {
    "nodes": {
      "rag-source": "nodes/source.js",
      "rag-normalize": "nodes/normalize.js",
      "rag-chunker": "nodes/chunker.js",
      "rag-embed": "nodes/embed.js",
      "rag-vector-upsert": "nodes/vector-upsert.js",
      "rag-retrieve": "nodes/retrieve.js",
      "rag-evidence-gate": "nodes/evidence-gate.js",
      "rag-prompt": "nodes/prompt.js",
      "rag-generate": "nodes/generate.js",
      "rag-grounding": "nodes/grounding.js",
      "rag-policy": "nodes/policy.js",
      "rag-observe": "nodes/observe.js",
      "rag-local-model": "nodes/local-model.js"
      ,"rag-quality-operations": "nodes/quality.js"
      ,"rag-providers": "nodes/providers.js"
    }
  },
  "files": ["nodes", "examples", "docs", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "test": "mocha --timeout 10000 'test/**/*.test.js'",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 80 --functions 80 --branches 40 npm test",
    "test:integration": "mocha --timeout 15000 'test/integration/**/*.test.js'",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test:coverage && npm run test:integration",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {},
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^15.14.0",
    "mocha": "^12.0.3",
    "node-red": "^5.0.8",
    "node-red-node-test-helper": "^0.3.5"
  },
  "overrides": {
    "sinon": "^22.1.0"
  }
}
